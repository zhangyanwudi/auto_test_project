{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "页面巡检模块契约",
  "description": "模块 JSON（page_patrol/modules/<模块>.json）的结构约束。AI 生成 case 时只能引用这里声明的路径、操作与字段。",
  "type": "object",
  "required": [
    "module",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "module": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "click",
            "type",
            "upload",
            "select_first",
            "press",
            "scroll",
            "wait",
            "repeat",
            "recognize",
            "select",
            "click_row",
            "table_select",
            "table_type",
            "table_upload",
            "click_css"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "up",
            "down"
          ]
        },
        "px": {
          "type": "integer",
          "minimum": 0
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "over": {
          "type": "string",
          "description": "repeat：循环的 data 键名（路径用 . 分隔，如 其他信息.x）"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "description": "repeat：循环体"
        },
        "nth": {
          "type": [
            "string",
            "integer"
          ],
          "description": "第 N 个匹配（0 起），可用 ${index}"
        },
        "except_last": {
          "type": "boolean",
          "description": "循环中最后一项不执行"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": [
            "string",
            "integer"
          ],
          "description": "表格行号（0 起），可用 ${index}"
        },
        "column": {
          "type": "string",
          "description": "表格列名（表头前缀匹配）"
        },
        "selector": {
          "type": "string",
          "description": "click_css：CSS 选择器"
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "anchor",
        "enter",
        "actions",
        "verify",
        "goals",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "enter": {
          "type": "object",
          "required": [
            "from",
            "actions"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/action"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "verify": {
          "type": [
            "string",
            "null"
          ]
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "object",
          "required": [
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "submit": {
              "$ref": "#/$defs/action"
            },
            "reset": {
              "$ref": "#/$defs/action"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/action"
              }
            }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "kind",
        "inputs",
        "enter",
        "steps",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "read",
            "write",
            "destructive"
          ],
          "description": "read 只读；write 会写入数据；destructive 删除类，默认禁止自动生成"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "verify": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "description": "录入数据，步骤里用 ${data.X} / ${item.X} / ${index} 引用"
        },
        "verify_row": {
          "type": [
            "string",
            "null"
          ],
          "description": "列表行校验：某元素文字必须完全等于该值（如本次唯一标识）"
        }
      }
    }
  }
}